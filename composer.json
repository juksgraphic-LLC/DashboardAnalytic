{
    "name": "juksgraphic/dashboardanalytic",
    "description": "This is my package dashboardanalytic",
    "keywords": [
        "Juksgraphic",
        "dashboardanalytic"
    ],
    "homepage": "https://github.com/juksgraphic-LLC/dashboardAnalytic",
    "license": "MIT",
    "authors": [
        {
            "name": "Kingsley Guillaume",
            "email": "kingsleyguillaume77@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/cache": "^8.1",
        "symfony/cache-contracts": "^3.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0",
        "friendsofphp/php-cs-fixer": "^3.21.1",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Juksgraphic\\DashboardAnalytic\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juksgraphic\\DashboardAnalytic\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
